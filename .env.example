# ---------------------------------------------------------------------------
# Copy this file to `.env` ON THE VPS and fill in real values.
# NEVER commit the real .env — it is gitignored for a reason.
#   cp .env.example .env && chmod 600 .env && nano .env
# README.md §3 explains where each of these values comes from.
# ---------------------------------------------------------------------------

# --- X (Twitter) API ------------------------------------------------------
# App-only Bearer Token from the X Developer Console.
X_BEARER_TOKEN=
# Numeric user ID for @NeedhamDriving (NOT the @handle).
# README.md §3.2 shows the one-line curl that looks this up.
X_ACCOUNT_USER_ID=

# --- Gmail SMTP -----------------------------------------------------------
GMAIL_ADDRESS=jaydenaleung@gmail.com
# 16-character Google App Password. Requires 2-Step Verification enabled.
# Paste it WITHOUT spaces.
GMAIL_APP_PASSWORD=

# Who the claim email is sent to.
CLAIM_EMAIL_TO=info@needhamdrivingschool.com
# Name used to sign the claim email.
CLAIM_FROM_NAME=Jayden Leung

# --- Claude (post parser) -------------------------------------------------
# Optional. If blank, the bot runs regex-only and says so on the dashboard.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- ntfy push notification ----------------------------------------------
# Topic names are effectively public — make this long and unguessable.
# Generate one with:  openssl rand -hex 16
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- Dashboard ------------------------------------------------------------
DASHBOARD_PASSWORD=
# Signs the login cookie. Generate with:  openssl rand -hex 32
SESSION_SECRET=

# --- Runtime --------------------------------------------------------------
PORT=8080
# Bind to loopback only; Caddy is the public-facing server.
HOST=127.0.0.1
DATABASE_PATH=./data/driversed.db
# Seconds between polls. Rate limit is 10,000 req/15min, so even 5s is safe
# (180 req/15min). Idle polls that return no new posts are not billed.
POLL_INTERVAL_SECONDS=10
# IANA timezone used to interpret post dates/times and to render the dashboard.
TIMEZONE=America/New_York

# --- Safety switches ------------------------------------------------------
# DRY_RUN=true  -> pipeline runs fully but NO email and NO ntfy push are sent.
# Leave true until you have watched it correctly identify a real lesson.
DRY_RUN=true
# POST_SOURCE=x       -> poll the live X API
# POST_SOURCE=replay  -> read fixtures/replay-posts.json instead, no API calls
POST_SOURCE=x
