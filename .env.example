# ---------------------------------------------------------------------------
# Copy this file to `.env` ON THE VPS and fill in real values.
# NEVER commit the real .env — it is gitignored for a reason.
#   cp .env.example .env && chmod 600 .env && nano .env
# README.md §3 explains where each of these values comes from.
# ---------------------------------------------------------------------------

# --- X (Twitter) API ------------------------------------------------------
# App-only Bearer Token from the X Developer Console.
X_BEARER_TOKEN=
# Numeric user ID for @NeedhamDriving (NOT the @handle).
# README.md §3.2 shows the one-line curl that looks this up.
X_ACCOUNT_USER_ID=

# --- Gmail SMTP -----------------------------------------------------------
GMAIL_ADDRESS=jaydenaleung@gmail.com
# 16-character Google App Password. Requires 2-Step Verification enabled.
# Paste it WITHOUT spaces.
GMAIL_APP_PASSWORD=

# Who the claim email is sent to.
CLAIM_EMAIL_TO=info@needhamdrivingschool.com
# Name used to sign the claim email.
CLAIM_FROM_NAME=Jayden Leung

# --- Claude (post parser) -------------------------------------------------
# Optional. If blank, the bot runs regex-only and says so on the dashboard.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- ntfy push notification ----------------------------------------------
# Topic names are effectively public — make this long and unguessable.
# Generate one with:  openssl rand -hex 16
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- Dashboard ------------------------------------------------------------
DASHBOARD_PASSWORD=
# Signs the login cookie. Generate with:  openssl rand -hex 32
SESSION_SECRET=

# --- Runtime --------------------------------------------------------------
PORT=8080
# Bind to loopback only; Caddy is the public-facing server.
HOST=127.0.0.1
DATABASE_PATH=./data/driversed.db
# Hard ceiling on billable X reads per UTC day. X charges per post RETURNED
# (idle polls are free), so this bounds the worst case if something goes wrong.
# Normal volume is ~10 posts/day; 400 = $2/day, which you should never reach.
MAX_POSTS_PER_DAY=400

# OPTIONAL ceiling on REQUESTS per UTC day. 0 = no ceiling (the default):
# poll until X itself refuses. Different from MAX_POSTS_PER_DAY above, which
# guards money — this would guard access.
#
# Left OFF deliberately. On 2 Sep 2026 about 18,000 requests in ~15 hours of
# 3-second polling ended in "usage cap exceeded", but X does not document a
# per-day request cap for this endpoint, so any value here is a guess — and a
# guessed ceiling mostly stops the bot from ever discovering the real one.
# Set a number to turn the guard on. The request COUNTER always runs regardless;
# see `npm run diagnose`.
MAX_REQUESTS_PER_DAY=0

# Seconds between polls. Per-window limits are not the constraint — this token
# reports 10,000 requests per 15 minutes, and even 3s is 300 of them. But
# 3s is 28,800 requests a DAY, which is what triggered the 2 Sep cutoff. 30s is
# 2,880/day and, since the school posts a handful of times a day, costs you at
# most 27 seconds of reaction time. Anything from 1 upwards is accepted.
POLL_INTERVAL_SECONDS=30
# IANA timezone used to interpret post dates/times and to render the dashboard.
TIMEZONE=America/New_York

# --- Safety switches ------------------------------------------------------
# DRY_RUN=true  -> pipeline runs fully but NO email and NO ntfy push are sent.
# Leave true until you have watched it correctly identify a real lesson.
DRY_RUN=true
# POST_SOURCE=x       -> poll the live X API
# POST_SOURCE=replay  -> read fixtures/replay-posts.json instead, no API calls
POST_SOURCE=x
