# Force LF for everything that Linux executes or parses.
# A shell script checked out with CRLF fails on the server with a confusing
# "bad interpreter: No such file or directory", and systemd/Caddy config files
# behave oddly with stray carriage returns.
* text=auto eol=lf
*.sh        text eol=lf
*.service   text eol=lf
Caddyfile   text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
