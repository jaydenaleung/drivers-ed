# Caddy config for the lesson bot dashboard.
# Install to /etc/caddy/Caddyfile, then: sudo systemctl reload caddy
#
# Pick ONE of the three options below and delete or comment out the others.
# Caddy fetches and renews the certificate automatically. The only prerequisite
# is that the hostname already points at this server's IP and that ports 80 and
# 443 are open.

# ---------------------------------------------------------------------------
# OPTION A — free DuckDNS subdomain. Costs $0/year and still gives you a real,
# browser-trusted Let's Encrypt certificate. Recommended: this dashboard is
# private to you, so a pretty domain buys nothing.
#
# Sign in at https://www.duckdns.org with GitHub/Google, claim a subdomain, and
# set its IP to this server. Then replace the hostname below.
# ---------------------------------------------------------------------------
drivers-ed.duckdns.org {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# The dashboard is self-contained — no external scripts, styles or images.
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
		-Server
	}

	log {
		output file /var/log/caddy/drivers-ed.log
		format console
	}
}

# ---------------------------------------------------------------------------
# OPTION B — your own domain (~$10/year). Identical behaviour to Option A, just
# a nicer hostname. Point an A record at this server's IP first.
# ---------------------------------------------------------------------------
# bot.example.com {
# 	encode zstd gzip
# 	reverse_proxy 127.0.0.1:8080
# 	header {
# 		Strict-Transport-Security "max-age=31536000; includeSubDomains"
# 		X-Content-Type-Options "nosniff"
# 		X-Frame-Options "DENY"
# 		Referrer-Policy "no-referrer"
# 		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
# 		-Server
# 	}
# }

# ---------------------------------------------------------------------------
# OPTION C — no hostname at all. Caddy issues a self-signed cert for the bare
# IP, so your browser warns once and you click through. Fine, but Option A is
# free and has no warning, so there is little reason to choose this.
# Replace 203.0.113.10 with your server's IP.
# ---------------------------------------------------------------------------
# https://203.0.113.10 {
# 	tls internal
# 	reverse_proxy 127.0.0.1:8080
# }
