[Unit]
Description=Needham Driving School lesson auto-claim bot
Documentation=https://github.com/jaydenaleung/drivers-ed
# Don't start before the network is up, or the first poll fails on every boot.
After=network-online.target
Wants=network-online.target

# These belong in [Unit] — systemd silently ignores them under [Service], which
# is why a bad config could restart-loop forever instead of failing visibly.
# After 5 failed starts in 60s, give up and leave the unit in a failed state so
# `systemctl status` shows the problem.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=driversed
Group=driversed
WorkingDirectory=/opt/drivers-ed

# Secrets live here, owned by driversed and chmod 600. Never in the repo.
EnvironmentFile=/opt/drivers-ed/.env

ExecStart=/usr/bin/node /opt/drivers-ed/src/index.js

# Restart on crash AND on clean exit — a bot that has quietly stopped is the
# failure mode this whole design is trying to avoid (§11 item 6).
Restart=always
RestartSec=5

# Exit code 78 is EX_CONFIG: the .env is wrong. Restarting cannot fix that, so
# fail immediately with the reason on screen rather than looping every 5s and
# burying it in the journal.
RestartPreventExitStatus=78

StandardOutput=journal
StandardError=journal
SyslogIdentifier=drivers-ed

# --- hardening -------------------------------------------------------------
# The bot needs: outbound HTTPS, its own directory, and nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# ProtectSystem=strict makes everything read-only, so punch a hole for the
# SQLite file and its WAL sidecars.
ReadWritePaths=/opt/drivers-ed/data

[Install]
WantedBy=multi-user.target
